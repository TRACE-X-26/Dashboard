# Safe default. Monitoring and simulations do not authorize physical tests.
ADS_MODE=simulation
ADS_HARDWARE_CONTROL_ENABLED=false
ADS_DATABASE_PATH=diagnostics.db
ADS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADS_LOG_LEVEL=INFO

# Matches the existing Nucleo-F401RE USART2/ST-LINK virtual COM configuration.
ADS_SERIAL_PORT=/dev/ttyACM0
ADS_SERIAL_BAUD=115200
ADS_SERIAL_READ_TIMEOUT=0.25
ADS_SERIAL_COMMAND_TIMEOUT=1.5

# Optional passive receiver on the Pi. Empty by default: no physical port opened.
# Review flashed firmware reset behavior before enabling, with motor energy off.
# ADS_LIVE_SERIAL_PORT=/dev/ttyACM0
# Passive reads existing plain-text telemetry and streamed JSON without writes.
# Set json only for the checked-in request/response ADS v1 firmware.
# ADS_LIVE_PROTOCOL=passive
# ADS_MODE remains simulation for the separate command/demo services.
# Mac Vite dev server can proxy to the Pi (set when starting npm run dev):
# ADS_BACKEND_URL=http://PI_HOSTNAME_OR_IP:13115

# Optional commissioned automated-test owner. Leave unset by default.
# A complete reviewed profile, exact USB/firmware identity, firmware gates,
# runtime interlock and fresh operator authorization are ALL required.
# ADS_AUTOMATION_HARDWARE_PROFILE=/absolute/path/to/approved-hardware-profile.json
# With a profile configured the passive serial reader is suppressed to prevent
# competing serial owners. Legacy controls remain simulation; use Run diagnostic.
# See docs/FULL_AUTOMATED_INTEGRATION.md. No physical enable flag is set here.

# New ADS 0.4.2 request/response firmware: optional read-only dual INA219 polling.
# ADS_LIVE_PROTOCOL=ads_json
# ADS_LIVE_SERIAL_PORT=/dev/ttyACM0
# This reader sends READ_MEASUREMENTS only; it shares ownership with motor runs.
# Monitoring CSVs are stored beside the database under sensor_csv/.
# Keep passive (default) for existing plain-text firmware.

# Direct motor Start/Stop requests: docs/SOFTWARE_PREFLIGHT_REMOVAL.md.
# ADS_AUTOMATION_HARDWARE_PROFILE supplies USB identity and optional run metadata.
# Motor requests do not require ADS_HARDWARE_CONTROL_ENABLED or cached preflight.
# This flag still authorizes circuit power; it does not prove hardware readiness.
# STM32 must enforce calibrated electrical protection, physical interlocks,
# downstream zero-PWM power checking, communication-loss stop and local deadline.
# Protected motor limits remain 10-14 V / 1.5 A; firmware output acceptance is unchanged.
